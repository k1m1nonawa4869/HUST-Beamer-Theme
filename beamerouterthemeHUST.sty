
%% beamerouterthemeHUST.sty -- Outer layout: header band, frametitle, footer for HUST theme
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemeHUST}[2026/10/26 HUST Beamer outer theme]

\mode<presentation>

\RequirePackage{tikz}

%% Disable navigation symbols for clean presentation
\setbeamertemplate{navigation symbols}{}

%% Margins
\setbeamersize{text margin left=\hust@fW{mL}, text margin right=\hust@fW{mL}}

%% ----------------------------------------------------------- Progress Bar & Section Tracking
\def\hust@nav@totalsecs{0}

\newcommand{\hust@read@nav}{%
  \ifnum\beamer@totalheads>0\relax
    \begingroup
      \def\slideentry##1##2##3##4##5##6{}%
      \def\beamer@framepages##1##2{}%
      \def\beamer@sectionpages##1##2{}%
      \def\beamer@subsectionpages##1##2{}%
      \def\beamer@partpages##1##2{}%
      \def\beamer@documentpages##1{}%
      \def\sectionentry##1##2##3##4##5{%
        \global\expandafter\def\csname hust@nav@sectitle@##1\endcsname{##4}%
        \def\hust@tmp@short{##2}%
        \ifx\hust@tmp@short\@empty
          \global\expandafter\def\csname hust@nav@secshort@##1\endcsname{##4}%
        \else
          \global\expandafter\def\csname hust@nav@secshort@##1\endcsname{##2}%
        \fi
        \global\expandafter\def\csname hust@nav@secpage@##1\endcsname{##3}%
        \ifcsname hust@nav@subcount@##1\endcsname\else
          \global\expandafter\def\csname hust@nav@subcount@##1\endcsname{0}%
        \fi
        \ifnum##1>\hust@nav@totalsecs\relax
          \xdef\hust@nav@totalsecs{##1}%
        \fi
      }%
      \def\beamer@subsectionentry##1##2##3##4##5{%
        \global\expandafter\def\csname hust@nav@subcount@##2\endcsname{##3}%
        \global\expandafter\def\csname hust@nav@subpage@##2@##3\endcsname{##4}%
      }%
      \gdef\hust@nav@totalsecs{0}%
      \dohead
    \endgroup
  \fi
}

\newdimen\hust@sec@w
\newdimen\hust@bar@w
\newdimen\hust@bar@gap
\newdimen\hust@bar@pad
\newdimen\hust@bar@step
\newdimen\hust@bar@avail
\newdimen\hust@sec@xl
\newdimen\hust@sec@xr
\newdimen\hust@sec@xm
\newdimen\hust@bar@xl
\newdimen\hust@bar@xr
\newdimen\hust@bar@ybot
\newdimen\hust@bar@ytop
\newcount\hust@sec@idx
\newcount\hust@sub@idx
\newcount\hust@sec@total
\newcount\hust@sub@total

\newsavebox\hust@prog@cachebox
\newsavebox\hust@prog@lblbox
\def\hust@prog@cachekey{}

\newcommand{\hust@draw@subbars@active}{%
  \ifnum\hust@sub@idx>\hust@sub@total\else
    \setlength{\hust@bar@xl}{\dimexpr\hust@bar@pad + \hust@bar@step * \numexpr\hust@sub@idx - 1\relax\relax}%
    \ifcsname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
      \expandafter\let\expandafter\hust@cur@subpage\csname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
    \else
      \def\hust@cur@subpage{}%
    \fi
    \rlap{%
      \kern\hust@bar@xl
      \raise 2pt\hbox{%
        \ifnum\hust@sub@idx=\c@subsection\relax
          \textcolor{hustyellow}{\vrule width \hust@bar@w height 1.5pt depth 0pt}%
        \else
          \ifx\hust@colname\hust@col@red
            \textcolor{hustlightred}{\vrule width \hust@bar@w height 1.5pt depth 0pt}%
          \else
            \textcolor{hustlightblue}{\vrule width \hust@bar@w height 1.5pt depth 0pt}%
          \fi
        \fi
      }%
    }%
    \ifx\hust@cur@subpage\@empty\else
      \rlap{%
        \kern\hust@bar@xl
        \raise 2pt\hbox{\hyperlink{Navigation\hust@cur@subpage}{\phantom{\rule{\hust@bar@w}{4pt}}}}%
      }%
    \fi
    \advance\hust@sub@idx by 1\relax
    \expandafter\hust@draw@subbars@active
  \fi
}

\newcommand{\hust@draw@subbars@inactive}{%
  \ifnum\hust@sub@idx>\hust@sub@total\else
    \setlength{\hust@bar@xl}{\dimexpr\hust@bar@pad + \hust@bar@step * \numexpr\hust@sub@idx - 1\relax\relax}%
    \ifcsname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
      \expandafter\let\expandafter\hust@cur@subpage\csname hust@nav@subpage@\the\hust@sec@idx @\the\hust@sub@idx\endcsname
    \else
      \def\hust@cur@subpage{}%
    \fi
    \rlap{%
      \kern\hust@bar@xl
      \raise 2pt\hbox{\textcolor{hustgray}{\vrule width \hust@bar@w height 1.5pt depth 0pt}}%
    }%
    \ifx\hust@cur@subpage\@empty\else
      \rlap{%
        \kern\hust@bar@xl
        \raise 2pt\hbox{\hyperlink{Navigation\hust@cur@subpage}{\phantom{\rule{\hust@bar@w}{4pt}}}}%
      }%
    \fi
    \advance\hust@sub@idx by 1\relax
    \expandafter\hust@draw@subbars@inactive
  \fi
}

\newdimen\hust@prog@texty

\newcommand{\hust@render@secloop}{%
  \ifnum\hust@sec@idx>\hust@sec@total\else
    \ifcsname hust@nav@secshort@\the\hust@sec@idx\endcsname
      \expandafter\let\expandafter\hust@cur@stitle\csname hust@nav@secshort@\the\hust@sec@idx\endcsname
    \else
      \def\hust@cur@stitle{}%
    \fi
    \ifcsname hust@nav@secpage@\the\hust@sec@idx\endcsname
      \expandafter\let\expandafter\hust@cur@spage\csname hust@nav@secpage@\the\hust@sec@idx\endcsname
    \else
      \def\hust@cur@spage{}%
    \fi
    \ifcsname hust@nav@subcount@\the\hust@sec@idx\endcsname
      \hust@sub@total=\csname hust@nav@subcount@\the\hust@sec@idx\endcsname\relax
    \else
      \hust@sub@total=0\relax
    \fi
    \ifnum\hust@sec@idx=\c@section\relax
      \def\hust@p@bgcol{hustmain}%
      \def\hust@p@fgcol{white}%
    \else
      \def\hust@p@bgcol{white}%
      \def\hust@p@fgcol{hustblack}%
    \fi
    \setbox\hust@prog@lblbox=\hbox{%
      \fontsize{6pt}{6.8pt}\selectfont\bfseries
      \color{\hust@p@fgcol}%
      \husttruncateto{\dimexpr\hust@sec@w - 4.5pt\relax}{\fontsize{6pt}{6.8pt}\selectfont\bfseries}{\hust@cur@stitle}%
    }%
    \hbox to \hust@sec@w{%
      \rlap{\textcolor{\hust@p@bgcol}{\vrule width \hust@sec@w height \hust@prog@h depth 0pt}}%
      \rlap{\raise\dimexpr \hust@prog@h * 6 / 10 - 0.5\ht\hust@prog@lblbox + 0.5\dp\hust@prog@lblbox\relax\hbox to \hust@sec@w{\hfil\box\hust@prog@lblbox\hfil}}%
      \ifx\hust@cur@spage\@empty\else
        \rlap{\hyperlink{Navigation\hust@cur@spage}{\phantom{\rule{\hust@sec@w}{\hust@prog@h}}}}%
      \fi
      \ifnum\hust@sub@total>0\relax
        \setlength{\hust@bar@pad}{4pt}%
        \setlength{\hust@bar@gap}{2.2pt}%
        \setlength{\hust@bar@avail}{\dimexpr\hust@sec@w - 2\hust@bar@pad - \hust@bar@gap * \numexpr\hust@sub@total - 1\relax\relax}%
        \setlength{\hust@bar@w}{\dimexpr\hust@bar@avail / \hust@sub@total\relax}%
        \setlength{\hust@bar@step}{\dimexpr\hust@bar@w + \hust@bar@gap\relax}%
        \hust@sub@idx=1\relax
        \ifnum\hust@sec@idx=\c@section\relax
          \hust@draw@subbars@active
        \else
          \hust@draw@subbars@inactive
        \fi
      \fi
      \rlap{\kern\dimexpr\hust@sec@w - 0.4pt\relax\textcolor{hustgrayline!40}{\vrule width 0.4pt height \hust@prog@h depth 0pt}}%
      \hfil
    }%
    \advance\hust@sec@idx by 1\relax
    \expandafter\hust@render@secloop
  \fi
}

\newcommand{\hust@render@progressbar}{%
  \ifnum\hust@nav@totalsecs=0\relax
    \hust@read@nav
  \fi
  \hust@sec@total=\hust@nav@totalsecs\relax
  \ifnum\hust@sec@total>0\relax
    \edef\hust@prog@wantkey{\the\c@section:\the\c@subsection:\the\hust@sec@total:\hust@colname:\the\dimexpr\hust@prog@h\relax}%
    \ifx\hust@prog@wantkey\hust@prog@cachekey\else
      \setlength{\hust@sec@w}{\dimexpr\paperwidth / \hust@sec@total\relax}%
      \global\setbox\hust@prog@cachebox=\hbox to \paperwidth{%
        \hust@sec@idx=1\relax
        \hust@render@secloop
        \hss
      }%
      \global\let\hust@prog@cachekey\hust@prog@wantkey
    \fi
    \copy\hust@prog@cachebox
  \fi
}

\newdimen\hust@cur@progh
\newif\ifhust@framenoprogressbar
\hust@framenoprogressbarfalse

\define@key{beamerframe}{noprogressbar}[]{\global\hust@framenoprogressbartrue}

\newcommand{\hust@eval@progh}{%
  \hust@cur@progh=0pt\relax
  \ifx\hust@progressbar\hust@opt@on
    \hust@cur@progh=\dimexpr\hust@prog@h\relax
    \ifnum\c@section=0\relax
      \hust@cur@progh=0pt\relax
    \fi
    \ifhust@framenoprogressbar
      \hust@cur@progh=0pt\relax
    \fi
  \fi
}


%% ----------------------------------------------------------- Header / Headline
\def\hust@hdr@pagenumber{pagenumber}
\def\hust@hdr@logo{logo}
\newsavebox\hust@hdr@rightbox
\newsavebox\hust@hdr@tmpbox
\newsavebox\hust@hdr@logocache
\def\hust@hdr@logokey{}
\newdimen\hust@cur@bandH
\newdimen\hust@cur@headerB
\newdimen\hust@title@avail@w
\newdimen\hust@hdr@accentH

\newcommand{\hust@eval@header@dims}{%
  \def\hust@bar@thick{thick}%
  \ifx\hust@bar\hust@bar@thick
    \setlength{\hust@cur@bandH}{\hust@fH{bandB}}%
    \setlength{\hust@cur@headerB}{\hust@fH{thickB}}%
  \else
    \setlength{\hust@cur@bandH}{\hust@fH{bandThinB}}%
    \setlength{\hust@cur@headerB}{\hust@fH{thinB}}%
  \fi
  \sbox\hust@hdr@rightbox{}%
  \ifx\hust@headerright\hust@hdr@pagenumber
    \ifx\hust@numbering\hust@num@none\else
      \sbox\hust@hdr@rightbox{%
        {\usebeamerfont{frametitle}\color{hustsubyellow}\strut%
          \ifx\hust@numbering\hust@num@fraction
            \insertframenumber/\inserttotalframenumber
          \else
            \insertframenumber
          \fi
        \strut}%
      }%
    \fi
  \else\ifx\hust@headerright\hust@hdr@logo
    \ifx\hust@headerlogo\@empty\else
      \edef\hust@want@logokey{\hust@headerlogo:\the\hust@cur@bandH}%
      \ifx\hust@want@logokey\hust@hdr@logokey\else
        \global\setbox\hust@hdr@logocache=\hbox{%
          \begingroup
            \setlength{\fboxsep}{1.4pt}%
            \colorbox{white}{%
              \hust@use@cachedimg{hdrlogo:\hust@want@logokey}{height=\dimexpr\hust@cur@bandH - 8.0pt\relax,keepaspectratio}{\hust@headerlogo}%
            }%
          \endgroup
        }%
        \global\let\hust@hdr@logokey\hust@want@logokey
      \fi
      \sbox\hust@hdr@rightbox{\copy\hust@hdr@logocache}%
    \fi
  \fi\fi
  \ifdim\wd\hust@hdr@rightbox>0pt\relax
    \setlength{\hust@title@avail@w}{\dimexpr\paperwidth - 2\hust@fW{mL} - \wd\hust@hdr@rightbox - 0.8em\relax}%
  \else
    \setlength{\hust@title@avail@w}{\dimexpr\paperwidth - 2\hust@fW{mL}\relax}%
  \fi
}

\defbeamertemplate*{headline}{HUST}{%
  \leavevmode%
  \hust@eval@progh
  \hust@eval@header@dims
  \setbox\hust@hdr@tmpbox=\hbox to 0pt{%
    %% Optional diagonal rounded-diamond texture from HUST Brand Guidebook Page 1 (compact bottom-right accent)
    \ifx\hust@framebg\hust@opt@on
      \ifhust@fast\else
        \hust@resolve@diagimg
        \def\hust@cur@framebgh{%
          \ifx\hust@framebg@height\hust@val@auto
            \ifhust@wide 0.26\paperheight\else 0.24\paperheight\fi
          \else
            \hust@framebg@height
          \fi
        }%
        \sbox\z@{\hust@use@cachedopacityimg{diag:\hust@diag@img:\the\dimexpr\hust@cur@framebgh\relax:\hust@framebg@opacity}{\hust@framebg@opacity}{height=\hust@cur@framebgh,keepaspectratio}{\hust@diag@img}}%
        \rlap{%
          \kern\dimexpr\paperwidth - \wd\z@\relax
          \raise\dimexpr -\hust@fH{footY} + 1.5pt + \dp\z@\relax\box\z@
        }%
      \fi
    \fi
    %% Progress bar at the top (if enabled and current frame allows)
    \ifdim\hust@cur@progh>0pt\relax
      \rlap{\raise -\hust@cur@progh\hbox{\hust@render@progressbar}}%
    \fi
    %% Main coloured header band and accent bar (pushed down by \hust@cur@progh)
    \def\hust@bar@thick{thick}%
    \ifx\hust@bar\hust@bar@thick
      \setlength{\hust@hdr@accentH}{\dimexpr\hust@fH{thickB} - \hust@fH{bandB}\relax}%
      \rlap{\raise -\dimexpr\hust@fH{bandB} + \hust@cur@progh\relax\hbox{\textcolor{hustmain}{\vrule width \paperwidth height \hust@fH{bandB} depth 0pt}}}%
      \rlap{\raise -\dimexpr\hust@fH{thickB} + \hust@cur@progh\relax\hbox{\textcolor{hustaccent}{\vrule width \paperwidth height \hust@hdr@accentH depth 0pt}}}%
    \else
      \setlength{\hust@hdr@accentH}{\dimexpr\hust@fH{thinB} - \hust@fH{ruleT}\relax}%
      \rlap{\raise -\dimexpr\hust@fH{bandThinB} + \hust@cur@progh\relax\hbox{\textcolor{hustmain}{\vrule width \paperwidth height \hust@fH{bandThinB} depth 0pt}}}%
      \rlap{\raise -\dimexpr\hust@fH{thinB} + \hust@cur@progh\relax\hbox{\textcolor{hustaccent}{\vrule width \paperwidth height \hust@hdr@accentH depth 0pt}}}%
    \fi
    %% Right side of frametitle bar: yellow page number or white-bordered logo
    \ifdim\wd\hust@hdr@rightbox>0pt\relax
      \rlap{%
        \kern\dimexpr\paperwidth - \hust@fW{mL} - \wd\hust@hdr@rightbox\relax
        \raise\dimexpr -\hust@cur@progh - \hust@cur@bandH/2 - 0.5\ht\hust@hdr@rightbox + 0.5\dp\hust@hdr@rightbox\relax\box\hust@hdr@rightbox
      }%
    \fi
    \hss
  }%
  \ht\hust@hdr@tmpbox=0pt\relax
  \dp\hust@hdr@tmpbox=0pt\relax
  \box\hust@hdr@tmpbox
}

\newcommand{\hust@check@hassub}{%
  \gdef\hust@hassub{0}%
  \begingroup
    \setbox\z@=\hbox{\normalfont\insertframesubtitle}%
    \ifdim\wd\z@>0pt\relax
      \protected@edef\hust@cur@sub{\insertframesubtitle}%
      \ifdefstring{\hust@cur@sub}{Hidden}{}{%
        \ifdefstring{\hust@cur@sub}{hidden}{}{%
          \ifdefstring{\hust@cur@sub}{none}{}{%
            \gdef\hust@hassub{1}%
          }%
        }%
      }%
    \fi
  \endgroup
}

%% ----------------------------------------------------------------- Frametitle
\defbeamertemplate*{frametitle}{HUST}[1][left]{%
  \nointerlineskip%
  \hust@eval@progh
  \hust@eval@header@dims
  \hust@check@hassub
  \setbox\hust@hdr@tmpbox=\hbox to 0pt{%
    \def\hust@bar@thick{thick}%
    \ifx\hust@bar\hust@bar@thick
      %% THICK BAR MODE: Subtitle moves into the thick accent bar with white text
      \sbox\z@{\parbox{\hust@title@avail@w}{\usebeamerfont{frametitle}\color{white}\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{frametitle}}{\insertframetitle}\strut}}%
      \rlap{\raise\dimexpr -\hust@cur@progh - \hust@fH{bandB}/2 - 0.5\ht\z@ + 0.5\dp\z@\relax\box\z@}%
      \ifnum\hust@hassub=1\relax
        \sbox\z@{\parbox{\dimexpr\paperwidth - 2\hust@fW{mL}\relax}{\usebeamerfont{framesubtitle}\color{HUSTWhite}\spaceskip=0.8\fontdimen2\font\raggedright\strut\husttruncateto{\dimexpr\paperwidth - 2\hust@fW{mL}\relax}{\usebeamerfont{framesubtitle}}{\insertframesubtitle}\strut}}%
        \rlap{\raise\dimexpr -\hust@cur@progh - (\hust@fH{bandB} + \hust@fH{thickB})/2 - 0.5\ht\z@ + 0.5\dp\z@\relax\box\z@}%
      \fi
    \else
      %% THIN BAR MODE: Standard layout
      \ifnum\hust@hassub=0\relax
        %% Single-line title: mathematically centered in the colored header band
        \sbox\z@{\parbox{\hust@title@avail@w}{\usebeamerfont{frametitle}\color{white}\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{frametitle}}{\insertframetitle}\strut}}%
        \rlap{\raise\dimexpr -\hust@cur@progh - \hust@fH{bandThinB}/2 - 0.5\ht\z@ + 0.5\dp\z@\relax\box\z@}%
      \else
        %% Title + Subtitle: vertically centered as a 2-line block inside the colored header band
        \sbox\z@{%
          \parbox{\hust@title@avail@w}{%
            {\usebeamerfont{frametitle}\color{white}\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{frametitle}}{\insertframetitle}\strut\par}%
            \nointerlineskip\vskip 1.5pt%
            {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\spaceskip=0.8\fontdimen2\font\raggedright\strut\husttruncateto{\hust@title@avail@w}{\usebeamerfont{framesubtitle}}{\insertframesubtitle}\strut\par}%
          }%
        }%
        \rlap{\raise\dimexpr -\hust@cur@progh - \hust@fH{bandThinB}/2 - 0.5\ht\z@ + 0.5\dp\z@\relax\box\z@}%
      \fi
    \fi
    \hss
  }%
  \ht\hust@hdr@tmpbox=0pt\relax
  \dp\hust@hdr@tmpbox=0pt\relax
  \noindent\box\hust@hdr@tmpbox%
  \def\hust@bar@thick{thick}%
  \ifx\hust@bar\hust@bar@thick
    \vskip\dimexpr\hust@fH{thickB} + \hust@cur@progh + 0.3em\relax%
  \else
    \vskip\dimexpr\hust@fH{thinB} + \hust@cur@progh + 0.4em\relax%
  \fi
}

%% ----------------------------------------------------------- Footer / Footline
\def\hust@logo@full{full}
\def\hust@logo@mark{mark}
\def\hust@logo@wordmark{wordmark}
\def\hust@logo@hust{hust}
\def\hust@logo@none{none}

\def\hust@num@none{none}
\def\hust@num@plain{plain}
\def\hust@num@fraction{fraction}

\newsavebox\hust@foot@authbox
\newsavebox\hust@foot@datebox
\newsavebox\hust@foot@numbox
\newsavebox\hust@foot@titlebox
\newdimen\hust@foot@ruleL
\newdimen\hust@foot@ruleW
\newdimen\hust@foot@dateL
\newdimen\hust@foot@authR
\newdimen\hust@foot@ruley
\newdimen\hust@foot@titley

\defbeamertemplate*{footline}{HUST}{%
  \leavevmode%
  %% Calculate logo file, width, and gap
  \def\hust@fimg{}%
  \def\hust@lw{0pt}%
  \def\hust@lgap{0pt}%
  \ifx\hust@flogo\hust@logo@full
    \def\hust@fimg{footer-full.png}%
    \def\hust@lw{\hust@fW{fullW}}%
    \def\hust@lgap{\hust@fW{gapfull}}%
  \else\ifx\hust@flogo\hust@logo@mark
    \def\hust@fimg{footer-mark.png}%
    \def\hust@lw{\hust@fW{markW}}%
    \def\hust@lgap{\hust@fW{gapmark}}%
  \else\ifx\hust@flogo\hust@logo@wordmark
    \def\hust@fimg{footer-wordmark.png}%
    \def\hust@lw{\hust@fW{wordmarkW}}%
    \def\hust@lgap{\hust@fW{gapwordmark}}%
  \else\ifx\hust@flogo\hust@logo@hust
    \def\hust@fimg{footer-hust.png}%
    \def\hust@lw{\hust@fW{hustW}}%
    \def\hust@lgap{\hust@fW{gaphust}}%
  \fi\fi\fi\fi
  \setlength{\hust@foot@ruleL}{\dimexpr\hust@fW{footX} + \hust@lw + \hust@lgap\relax}%
  \setlength{\hust@foot@ruleW}{\dimexpr\hust@fW{footXend} - \hust@foot@ruleL\relax}%
  \setbox\hust@hdr@tmpbox=\hbox to \paperwidth{%
    %% Place footer logo at bottom left (centred vertically on footY)
    \ifx\hust@fimg\@empty\else
      \sbox\z@{\hust@use@cachedimg{flogo:\hust@fimg:\the\dimexpr\hust@lw\relax}{width=\hust@lw}{\hust@fimg}}%
      \rlap{\kern\hust@fW{footX}\raise\dimexpr\paperheight - \hust@fH{footY} - 0.5\ht\z@ + 0.5\dp\z@\relax\box\z@}%
    \fi
    %% Dynamic footer bar & citations placement:
    \ifnum\c@hust@slide@citecount=0\relax
      \ifhust@footermeta
        \def\hust@show@footnum{1}%
        \ifx\hust@numbering\hust@num@none
          \def\hust@show@footnum{0}%
        \fi
        \ifx\hust@headerright\hust@hdr@pagenumber
          \def\hust@show@footnum{0}%
        \fi
        \sbox\hust@foot@datebox{{\usebeamerfont{footermeta}\color{hustmain}\strut\hust@cur@footerdate}}%
        \ifnum\hust@show@footnum=0\relax
          \setlength{\hust@foot@dateL}{\dimexpr\hust@fW{footXend} - \wd\hust@foot@datebox\relax}%
        \else
          \sbox\hust@foot@numbox{%
            {\usebeamerfont{page number in head/foot}\color{hustmain}\strut%
              \ifx\hust@numbering\hust@num@fraction
                \insertframenumber\,/\,\inserttotalframenumber
              \else
                \insertframenumber
              \fi
            }%
          }%
          \setlength{\hust@foot@dateL}{\dimexpr\hust@fW{numR} - \wd\hust@foot@numbox - 1.5em - \wd\hust@foot@datebox\relax}%
          \rlap{%
            \kern\dimexpr\hust@fW{numR} - \wd\hust@foot@numbox\relax
            \raise\dimexpr\paperheight - \hust@fH{numY} + \dp\hust@foot@numbox\relax\box\hust@foot@numbox
          }%
        \fi
        \rlap{%
          \kern\hust@foot@dateL
          \raise\dimexpr\paperheight - \hust@fH{numY} + \dp\hust@foot@datebox\relax\box\hust@foot@datebox
        }%
        \sbox\hust@foot@authbox{{\usebeamerfont{footermeta}\color{hustmain}\strut\hust@cur@footerauthor}}%
        \setlength{\hust@foot@authR}{\dimexpr\hust@foot@ruleL + \wd\hust@foot@authbox\relax}%
        \rlap{%
          \kern\hust@foot@ruleL
          \raise\dimexpr\paperheight - \hust@fH{numY} + \dp\hust@foot@authbox\relax\box\hust@foot@authbox
        }%
        \sbox\hust@foot@titlebox{%
          \parbox[b]{\dimexpr\hust@foot@dateL - \hust@foot@authR - 2.0em\relax}{%
            \centering\usebeamerfont{footermeta}\color{hustmain}\strut%
            \hust@cur@footertitle\strut
          }%
        }%
        \rlap{%
          \kern\dimexpr(\hust@foot@authR + \hust@foot@dateL - \wd\hust@foot@titlebox) / 2\relax
          \raise\dimexpr\paperheight - \hust@fH{numY} + \dp\hust@foot@titlebox\relax\copy\hust@foot@titlebox
        }%
        %% Accent rule: stays at footY if 1 line, or lifts up if title has multiple lines
        \setlength{\hust@foot@titley}{\dimexpr\paperheight - \hust@fH{numY} + \ht\hust@foot@titlebox + \dp\hust@foot@titlebox + 3.5pt\relax}%
        \setlength{\hust@foot@ruley}{\dimexpr\paperheight - \hust@fH{footY}\relax}%
        \ifdim\hust@foot@titley>\hust@foot@ruley
          \setlength{\hust@foot@ruley}{\hust@foot@titley}%
        \fi
        \rlap{%
          \kern\hust@foot@ruleL
          \raise\dimexpr\hust@foot@ruley - 0.5\hust@fH{footLineH}\relax\hbox{\textcolor{hustaccent}{\vrule width \hust@foot@ruleW height \hust@fH{footLineH} depth 0pt}}%
        }%
      \else
        \rlap{%
          \kern\hust@foot@ruleL
          \raise\dimexpr\paperheight - \hust@fH{footY} - 0.5\hust@fH{footLineH}\relax\hbox{\textcolor{hustaccent}{\vrule width \hust@foot@ruleW height \hust@fH{footLineH} depth 0pt}}%
        }%
        \ifx\hust@footertext\@empty\else
          \sbox\z@{{\usebeamerfont{footer}\color{hustblack}\hust@footertext}}%
          \rlap{\kern\hust@foot@ruleL\raise\dimexpr\paperheight - \hust@fH{footY} + 2pt + \dp\z@\relax\box\z@}%
        \fi
      \fi
    \fi
    \ifnum\c@hust@slide@citecount>0\relax
      \hust@build@slide@citebox
    \fi
    \ifnum\hust@cite@rows=1\relax
      \rlap{%
        \kern\hust@foot@ruleL
        \raise\dimexpr\paperheight - \hust@fH{footY} - 0.5\hust@fH{footLineH}\relax\hbox{\textcolor{hustaccent}{\vrule width \hust@foot@ruleW height \hust@fH{footLineH} depth 0pt}}%
      }%
      \rlap{%
        \kern\hust@foot@ruleL
        \raise\dimexpr\paperheight - \hust@fH{footY} - 2pt - \ht\hust@slide@citebox\relax\copy\hust@slide@citebox
      }%
    \fi
    \ifnum\hust@cite@rows>1\relax
      \rlap{%
        \kern\hust@foot@ruleL
        \raise\dimexpr\paperheight - \hust@fH{numY} + \dp\hust@slide@citebox\relax\copy\hust@slide@citebox
      }%
      \setlength{\hust@foot@ruley}{\dimexpr\paperheight - \hust@fH{numY} + \ht\hust@slide@citebox + \dp\hust@slide@citebox + 3pt\relax}%
      \rlap{%
        \kern\hust@foot@ruleL
        \raise\dimexpr\hust@foot@ruley - 0.5\hust@fH{footLineH}\relax\hbox{\textcolor{hustaccent}{\vrule width \hust@foot@ruleW height \hust@fH{footLineH} depth 0pt}}%
      }%
    \fi
    %% Slide numbering (right aligned at numR) when footermeta is off or cites active, unless moved to header
    \ifx\hust@headerright\hust@hdr@pagenumber\else
      \def\hust@draw@fnum{0}%
      \ifhust@footermeta
        \ifnum\c@hust@slide@citecount>0\relax \def\hust@draw@fnum{1}\fi
      \else
        \def\hust@draw@fnum{1}%
      \fi
      \ifnum\hust@draw@fnum=1\relax
        \ifx\hust@numbering\hust@num@none\else
          \sbox\hust@foot@numbox{%
            {\usebeamerfont{page number in head/foot}\color{hustmain}%
              \ifx\hust@numbering\hust@num@fraction
                \insertframenumber\,/\,\inserttotalframenumber
              \else
                \insertframenumber
              \fi
            }%
          }%
          \rlap{%
            \kern\dimexpr\hust@fW{numR} - \wd\hust@foot@numbox\relax
            \raise\dimexpr\paperheight - \hust@fH{numY} - 0.5\ht\hust@foot@numbox + 0.5\dp\hust@foot@numbox\relax\box\hust@foot@numbox
          }%
        \fi
      \fi
    \fi
    \hfil
  }%
  \ht\hust@hdr@tmpbox=0pt\relax
  \dp\hust@hdr@tmpbox=0pt\relax
  \vbox to \dimexpr\paperheight - \hust@fH{bodyBot}\relax{\offinterlineskip\vss\noindent\box\hust@hdr@tmpbox}%
  \global\setbox\hust@slide@citebox=\box\voidb@x%
  \global\c@hust@slide@citecount=0\relax%
  \gdef\hust@cite@rows{0}%
  \global\c@footnote=0\relax%
}

